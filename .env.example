# Reel Room: keys. Copy this file to .env and fill in what you have.
# Keys are read from this .env file or from your environment, nothing else. Never commit .env.

# OpenRouter: RECOMMENDED.  Get one: https://openrouter.ai/keys
#   Turns on: the fast planner (about 20 s per reel instead of Claude writing the plan), model picks for every beat
#   and hero, the number check's model verdict, the vision judge (taste QA, judge.py) and analyze_refs.
#   Without it: Claude Code writes and checks the plan itself; the judge and analyze_refs are off.
#   Cost: planner about $0.03 to $0.05 per reel; judge about $0.005 per clip (about $0.04 with --strong).
OPENROUTER_API_KEY=

# Gemini: optional.  Free key: https://aistudio.google.com/apikey
#   Turns on: the AI style scan ("learn a style from my reels"). Reels you scan are uploaded to Google for the
#   analysis and deleted right after. Without it the scan is a basic pixel read.
GEMINI_API_KEY=

# Zernio: optional, only for automatic posting (engine/post.py). https://zernio.com
ZERNIO_API_KEY=
